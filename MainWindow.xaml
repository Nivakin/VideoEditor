<Window x:Class="VideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Editor" Height="720" Width="1100" MinWidth="700" MinHeight="450">
    <DockPanel Margin="8">
        <!-- Record bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="_Source:" Target="{Binding ElementName=SourceBox}" VerticalAlignment="Center"/>
            <ComboBox x:Name="SourceBox" Width="360" VerticalAlignment="Center" AutomationProperties.Name="Recording source"/>
            <Button Content="↻" Width="28" Margin="4,0" Click="RefreshSources_Click" ToolTip="Refresh screens and windows" AutomationProperties.Name="Refresh sources"/>
            <CheckBox x:Name="MicBox" Content="_Mic" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="SystemAudioBox" Content="S_ystem audio" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Label Content="_FPS:" Target="{Binding ElementName=FpsBox}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="FpsBox" Width="60" SelectedIndex="1" VerticalAlignment="Center" AutomationProperties.Name="Frames per second">
                <ComboBoxItem>30</ComboBoxItem>
                <ComboBoxItem>60</ComboBoxItem>
            </ComboBox>
            <Button x:Name="RecordButton" Content="● _Record" Width="100" Margin="12,0,0,0" Click="Record_Click"/>
            <Button Content="_Open video…" Margin="8,0,0,0" Padding="8,0" Click="Open_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Text="Ready."/>

        <!-- Segments panel -->
        <DockPanel DockPanel.Dock="Right" Width="260" Margin="8,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Segments to keep" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button Content="Remove selected" Click="RemoveSegment_Click" Margin="0,0,0,4"/>
                <Button x:Name="ExportButton" Content="_Export…" Click="Export_Click" FontWeight="SemiBold"/>
            </StackPanel>
            <ListBox x:Name="SegmentList" AutomationProperties.Name="Segments to keep"/>
        </DockPanel>

        <!-- Player + trim controls -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Slider x:Name="Seek" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="Seek_ValueChanged" AutomationProperties.Name="Playback position"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="PlayButton" Content="▶ _Play" Width="80" Click="Play_Click"/>
                <TextBlock x:Name="TimeText" Width="170" Margin="8,0" VerticalAlignment="Center" Text="00:00:00.0 / 00:00:00.0"/>
                <Button Content="Set _In" Width="70" Click="SetIn_Click"/>
                <Button Content="Set O_ut" Width="70" Margin="4,0" Click="SetOut_Click"/>
                <TextBlock x:Name="MarkText" Margin="8,0" VerticalAlignment="Center" Text="In: –   Out: –"/>
                <Button Content="_Add segment" Padding="8,0" Click="AddSegment_Click"/>
            </StackPanel>
        </StackPanel>

        <Border Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
        </Border>
    </DockPanel>
</Window>
